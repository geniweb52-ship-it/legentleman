# Fichiers internes au projet : jamais accessibles depuis le navigateur.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.git|sql|deploy|node_modules|includes|assets/src)(/|$) - [F,L]
    # Référencement Google : fichiers générés en PHP (adresse du site automatique).
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

<FilesMatch "^(config(\.example)?\.php|package(-lock)?\.json|tailwind\.config\.js|composer\.(json|lock)|\.env.*|\.git.*|.*\.(sql|md|log|bak))$">
    Require all denied
</FilesMatch>
