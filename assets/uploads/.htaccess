# Empêche l'exécution de scripts dans le dossier des images envoyées.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
